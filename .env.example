# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: FREE CLAUDE CODE PROXY (.env.example)
# ==============================================================================
# Copia este archivo como '.env' dentro de tu carpeta de usuario: $HOME\.fcc\.env
# Reemplaza los valores de ejemplo con tus propias claves gratuitas.

FCC_CONFIG_SCHEMA=1

# Token interno del proxy (no modificar a menos que cambies el cliente)
ANTHROPIC_AUTH_TOKEN=freecc

# ------------------------------------------------------------------------------
# 1. CLAVES DE API GRATUITAS (PROVEEDORES PÚBLICOS)
# ------------------------------------------------------------------------------

# Google AI Studio (Obtén tu clave gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_de_google_gemini_aqui

# NVIDIA NIM (Obtén tu clave gratis en https://build.nvidia.com/)
NVIDIA_NIM_API_KEY=tu_clave_nvapi_de_nvidia_aqui

# Groq Cloud (Opcional - Obtén tu clave gratis en https://console.groq.com/)
GROQ_API_KEY=tu_clave_gsk_de_groq_aqui

# ------------------------------------------------------------------------------
# 2. JERARQUÍA DE MODELOS ASIGNADOS (ROLES CLAUDE CODE)
# ------------------------------------------------------------------------------

# Modelo por defecto para todas las peticiones generales
MODEL=gemini/models/gemini-2.5-flash

# Nivel OPUS: Para arquitectura profunda y razonamiento complejo
MODEL_OPUS=nvidia_nim/nvidia/nemotron-3-super-120b-a12b

# Nivel SONNET: Para desarrollo de software diario, edición y refactorización
MODEL_SONNET=gemini/models/gemini-2.5-flash

# Nivel HAIKU: Para respuestas ultrarrápidas, tareas de git y resúmenes
MODEL_HAIKU=nvidia_nim/meta/llama-3.2-90b-vision-instruct

# Modelos de respaldo automático si el modelo principal entra en enfriamiento (429)
MODEL_FALLBACKS=nvidia_nim/meta/llama-3.2-90b-vision-instruct,nvidia_nim/nvidia/nemotron-3-super-120b-a12b

# ------------------------------------------------------------------------------
# 3. RED Y CONTROL DE FLUJO (ANTI-LÍMITES)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8082
PROXY_AUTH_ENABLED=true

# Concurrencia máxima y control de peticiones por minuto para cuentas libres
PROVIDER_MAX_CONCURRENCY=4
PROVIDER_RATE_LIMIT=30
PROVIDER_RATE_WINDOW=3

# Tiempos de espera de conexión (en segundos)
HTTP_CONNECT_TIMEOUT=60
HTTP_READ_TIMEOUT=900
HTTP_WRITE_TIMEOUT=120

# ------------------------------------------------------------------------------
# 4. POLÍTICAS DE RAZONAMIENTO Y OPTIMIZACIÓN
# ------------------------------------------------------------------------------
FAST_PREFIX_DETECTION=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_WEB_SERVER_TOOLS=true

REASONING_POLICY=client
REASONING_OPUS=client
REASONING_HAIKU=client
