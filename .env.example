# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: FREE CLAUDE CODE (TIER-0 ARCHITECTURE)
# ==============================================================================
# Copia este archivo como '.env' dentro de tu carpeta: $HOME\.fcc\.env
# Coloca tus claves gratuitas en las variables correspondientes.

FCC_CONFIG_SCHEMA=1

# Token interno del proxy
ANTHROPIC_AUTH_TOKEN=freecc

# ------------------------------------------------------------------------------
# 1. CLAVES DE API GRATUITAS (PROVEEDORES PÚBLICOS)
# ------------------------------------------------------------------------------

# Google AI Studio (1M de contexto gratuito en https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_de_google_gemini_aqui

# Groq Cloud (Inferencia a 300 tokens/s en LPUs en https://console.groq.com/)
GROQ_API_KEY=tu_clave_gsk_de_groq_aqui

# NVIDIA NIM (Clúster de cómputo H100 en https://build.nvidia.com/)
NVIDIA_NIM_API_KEY=tu_clave_nvapi_de_nvidia_aqui

# ------------------------------------------------------------------------------
# 2. JERARQUÍA DE MODELOS TIER-0 (MÁXIMA POTENCIA SIN PAGAR)
# ------------------------------------------------------------------------------

# Modelo por defecto para peticiones estándar
MODEL=gemini/models/gemini-2.5-flash
MODEL_OPUS=gemini/models/gemini-2.5-flash
MODEL_SONNET=gemini/models/gemini-2.5-flash
MODEL_HAIKU=groq/qwen/qwen3.8-27b
MODEL_FALLBACKS=nvidia_nim/meta/llama-3.2-90b-vision-instruct,nvidia_nim/nvidia/nemotron-3-super-120b-a12b,groq/openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. RED, CONCURRENCIA Y CONTROL DE TRÁFICO
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8082
PROXY_AUTH_ENABLED=true

# Ajuste óptimo para evitar bloqueos por peticiones por minuto
PROVIDER_MAX_CONCURRENCY=4
PROVIDER_RATE_LIMIT=30
PROVIDER_RATE_WINDOW=3

# Tiempos de espera de red (en segundos)
HTTP_CONNECT_TIMEOUT=60
HTTP_READ_TIMEOUT=900
HTTP_WRITE_TIMEOUT=120

# ------------------------------------------------------------------------------
# 4. POLÍTICAS DE RAZONAMIENTO Y HERRAMIENTAS
# ------------------------------------------------------------------------------
FAST_PREFIX_DETECTION=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_WEB_SERVER_TOOLS=true

REASONING_POLICY=client
REASONING_OPUS=client
REASONING_HAIKU=client
REASONING_SONNET=client
