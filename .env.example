# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: FREE CLAUDE CODE (PRO ARCHITECTURE)
# ==============================================================================
# Copia este archivo como '.env' dentro de tu carpeta: $HOME\.fcc\.env
# Coloca tus claves gratuitas en las variables correspondientes.

FCC_CONFIG_SCHEMA=1

# Token interno del proxy
ANTHROPIC_AUTH_TOKEN=freecc

# ------------------------------------------------------------------------------
# 1. CLAVES DE API GRATUITAS (PROVEEDORES PÚBLICOS)
# ------------------------------------------------------------------------------

# Google AI Studio (1M de contexto gratuito en https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_de_google_gemini_aqui

# Groq Cloud (Inferencia a 300 tokens/s en LPUs en https://console.groq.com/)
GROQ_API_KEY=tu_clave_gsk_de_groq_aqui

# NVIDIA NIM (Clúster de cómputo H100 en https://build.nvidia.com/)
NVIDIA_NIM_API_KEY=tu_clave_nvapi_de_nvidia_aqui

# ------------------------------------------------------------------------------
# 2. JERARQUÍA DE MODELOS Y CASCADA DE FALLBACKS (OPTIMIZADO)
# ------------------------------------------------------------------------------

# Motor primario de desarrollo (NVIDIA Nemotron 120B: 120B parámetros, alta precisión en herramientas)
MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
MODEL_OPUS=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
MODEL_SONNET=nvidia_nim/nvidia/nemotron-3-super-120b-a12b

# Motor ultrarrápido para subtareas, títulos y análisis ligero (1M contexto, 30 RPM)
MODEL_HAIKU=gemini/models/gemini-2.5-flash-lite

# Cascada de relevo automático ante límites de cuota (Zero-Downtime Fallback)
MODEL_FALLBACKS=gemini/models/gemini-2.5-flash-lite,gemini/models/gemini-3-flash-preview

# ------------------------------------------------------------------------------
# 3. RED, CONCURRENCIA Y CONTROL DE TRÁFICO ANTI-429
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8082
PROXY_AUTH_ENABLED=true

# Ventana deslizante estricta (14 peticiones cada 60s para respetar cuotas gratuitas)
PROVIDER_MAX_CONCURRENCY=1
PROVIDER_RATE_LIMIT=14
PROVIDER_RATE_WINDOW=60

# Tiempos de espera de red (en segundos)
HTTP_CONNECT_TIMEOUT=60
HTTP_READ_TIMEOUT=900
HTTP_WRITE_TIMEOUT=120

# Evitar apertura automática del navegador en segundo plano
FCC_OPEN_BROWSER=false

# Registro detallado de trazas de error para diagnóstico
LOG_API_ERROR_TRACEBACKS=true

# ------------------------------------------------------------------------------
# 4. POLÍTICAS DE RAZONAMIENTO Y HERRAMIENTAS
# ------------------------------------------------------------------------------
FAST_PREFIX_DETECTION=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_WEB_SERVER_TOOLS=true

REASONING_POLICY=client
REASONING_OPUS=client
REASONING_HAIKU=client
REASONING_SONNET=client
